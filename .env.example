# Optional: used only by the Next.js server proxy. Never place credentials here.
API_ORIGIN=http://127.0.0.1:8000
# Optional absolute path for the backend's local, single-user data directory.
# Set this in your shell before npm run dev; the backend does not read .env files.
# ADS_DATA_DIR=/absolute/path/to/local-ads-data
# Optional NVIDIA explanations: prefer the AI Assistant page to store a key locally.
# Alternatively export NVIDIA_API_KEY in the backend's launch environment.
# The launcher does not read this example file. Never use a NEXT_PUBLIC_ secret.
# Hosted single-owner deployment only (see docs/hosting.md).
# Set ADS_ACCESS_PASSWORD privately on BOTH Vercel and the backend; minimum 32 characters.
# Never commit its real value. Vercel automatically requires it in hosted deployments.
# Backend-only settings:
# ADS_HOSTED=1
# ADS_ALLOWED_ORIGINS=https://black-stone-8p52.vercel.app
# ADS_DATA_DIR=/var/data/ads-optimizer

# Vercel-only: connect Postgres via Vercel Storage (private environment values).
# ADS_DATABASE_URL, POSTGRES_URL or DATABASE_URL supplies durable workspace storage.
# No API_ORIGIN is needed on Vercel; see docs/vercel.md.
